# Copy to .env for local dev (packages/server reads these via process.env).
NODE_ENV=development
PORT=3001

# Single shared login password for the app.
APP_PASSWORD=change-me

# Random string, at least 32 characters, used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me

# Your raid-helper.xyz API key (Discord bot dashboard). Server-side only —
# never exposed to the browser.
RAID_HELPER_API_KEY=

# Where the SQLite database file lives.
DB_PATH=./data/raidschedule.db
